[Unit]
Description=Restore PrivacyPi active VPN mode on boot
After=privacypi-firewall.service network-online.target
Wants=network-online.target
Requires=privacypi-firewall.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'mode=$(python3 -c "import json; print(json.load(open(\"/var/lib/privacypi/active-vpn\")).get(\"mode\",\"direct\"))" 2>/dev/null || echo direct); /opt/privacypi/scripts/route-mode.sh "$mode"'
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
