[Unit]
Description=Restore PrivacyPi active VPN mode on boot
After=privacypi-firewall.service network-online.target
Wants=network-online.target
Requires=privacypi-firewall.service

[Service]
Type=oneshot
ExecStart=/opt/privacypi/scripts/vpn-connect.sh restore
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
